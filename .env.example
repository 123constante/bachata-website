# Build-time environment for the public site.
#
# Copy to `.env` and fill in. Every name here is read through
# `import.meta.env.*`, so all of them are BAKED INTO THE CLIENT BUNDLE at build
# time and none of them may hold a secret. A value that must stay private does
# not belong in a VITE_ variable at all.
#
# `.gitignore` un-ignores THIS file (`!.env.example`) and ignores every real
# `.env*`. Add a name here when you add one to the code -- a build-time var
# that appears in no committed artefact is a var the next operator cannot know
# to set, and Vite substitutes a missing one silently.

# --- Supabase (required; the app does not function without these) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# --- Home map basemap (optional, but see the warning) ---
# ArcGIS PUBLIC, referrer-locked client key for the vector basemap.
#
# OMITTING THIS IS SILENT, AND THAT IS THE TRAP. `vectorStyleUrl()` returns
# null, the map falls back to the legacy raster pair, and you get a working
# map at HALF RESOLUTION on any DPR>=2 screen -- which is the entire reason
# the vector basemap exists. There is no error, no failed request, no red
# gate, and the deploy is green. On a ~95%-mobile site the fallback is what
# most visitors would see.
#
# It is referrer-locked per HOST, so the apex and `www` are two separate
# entries on the ArcGIS item and BOTH are needed. It also depends on
# `vercel.json` keeping `Referrer-Policy: strict-origin-when-cross-origin`.
# Both traps are documented at the top of src/modules/home-map/vectorBasemap.ts
# -- read that header before changing the key or the item's referrer list.
VITE_ARCGIS_API_KEY=

# --- Feature flags (optional; unset reads as off) ---
VITE_ENABLE_TEACHERS_DIRECTORY=
VITE_ENABLE_TEACHER_DETAIL=
VITE_ENABLE_ORGANISERS_DIRECTORY=
VITE_ENABLE_ORGANISER_DETAIL=
VITE_ENABLE_VENUE_DETAIL=
VITE_ENABLE_RAFFLES_PAGE=
VITE_ENABLE_SEARCH_V5=
VITE_ENABLE_RUM=
VITE_ENABLE_CITY_REQUESTS=

# --- Local dev auth bypass (DEV only; ignored unless import.meta.env.DEV) ---
# See README. Both must be present for the Dev quick login action to appear.
VITE_DEV_AUTH_EMAIL=
VITE_DEV_AUTH_PASSWORD=
