exports[`PublicDancerPageV2 embedded > standalone markup is byte-for-byte what it was before the prop existed 1`] = `"<div data-profile="dancer" data-testid="dancer-page-v2" class="relative z-10 rounded-[14px] overflow-hidden px-4 pb-6 pt-3" style="background: rgb(6, 25, 31); color: rgb(234, 247, 250); isolation: isolate;"><div class="flex items-center justify-between" style="min-height: 44px;"><a class="inline-flex items-center gap-2 text-[15px] font-bold" style="min-height: 44px; color: rgb(234, 247, 250);" data-testid="dancer-back" href="/dancers" data-discover="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left w-4 h-4" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> Back</a><div><button type="button" class="inline-flex items-center gap-2 px-2 text-[15px] font-bold" style="min-height: 44px; color: rgb(234, 247, 250);" data-testid="dancer-share"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share2 w-4 h-4" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg> Share</button><p role="status" aria-live="polite" class="text-[13px] text-right" style="color: rgb(143, 186, 199);" data-testid="dancer-share-status"></p></div></div><header class="mt-2 rounded-[24px] px-4 pt-[22px] pb-2 text-center" style="background: linear-gradient(160deg, rgb(28, 125, 147) 0%, rgb(15, 84, 104) 55%, rgb(10, 58, 74) 100%); border: 1px solid rgb(42, 124, 144); box-shadow: 0 10px 30px rgba(0,0,0,.4);" data-testid="dancer-portrait"><div class="text-[11px] tracking-[2px]" style="color: rgb(207, 243, 246);">DANCER</div><div class="relative mx-auto mt-3.5" style="width: 116px; height: 116px;"><div class="w-full h-full rounded-full box-border flex items-center justify-center overflow-hidden" style="border: 4px solid rgb(94, 224, 230); background: rgb(6, 48, 59);"><img src="https://cdn.example.test/p.jpg" alt="Ricky Q" width="108" height="108" loading="eager" data-face="photo" style="width: 108px; height: 108px; border-radius: 50%; flex: 0 0 auto; object-fit: cover;"></div><span role="img" aria-label="Nationality: Ecuador" title="Ecuador" data-nationality-flag="EC" class="pointer-events-none absolute z-[2] block select-none overflow-hidden" style="top: -6%; right: -14%; width: 42px; height: 28px; transform: rotate(9deg); border-radius: 3px; box-shadow: 0 0 0 2px #fff, 0 3px 8px rgba(0,0,0,.6);"><svg aria-hidden="true" focusable="false" viewBox="0 0 30 20" preserveAspectRatio="xMidYMid slice" class="block h-full w-full"><rect x="0" y="0" width="30" height="10" fill="#FFDD00"></rect><rect x="0" y="10" width="30" height="5" fill="#034EA2"></rect><rect x="0" y="15" width="30" height="5" fill="#ED1C24"></rect><ellipse cx="15" cy="10" rx="2.4" ry="3" fill="#7A5C2E"></ellipse></svg></span></div><h1 class="mt-3 text-[26px] font-extrabold leading-tight break-words line-clamp-3" data-testid="dancer-name">Ricky Q</h1><p class="mt-0.5 text-[14px]" style="color: rgb(221, 246, 248);" data-testid="dancer-role-line">Leader · London</p><div class="mt-4 grid" style="grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(255, 255, 255, 0.28);" data-testid="dancer-facts"><div class="min-w-0 px-1 py-3 text-center"><div class="text-[11px] tracking-[2px] uppercase" style="color: rgb(191, 233, 238);">Dancing</div><div class="mt-1 text-[15px] font-extrabold leading-tight break-words">11 years</div></div><div class="min-w-0 px-1 py-3 text-center"><div class="text-[11px] tracking-[2px] uppercase" style="color: rgb(191, 233, 238);">Level</div><div class="mt-1 text-[15px] font-extrabold leading-tight break-words">Veteran</div></div><div class="min-w-0 px-1 py-3 text-center"><div class="text-[11px] tracking-[2px] uppercase" style="color: rgb(191, 233, 238);">Style</div><div class="mt-1 text-[15px] font-extrabold leading-tight break-words">Sensual</div></div></div><div class="px-1 py-3" style="border-top: 1px solid rgba(255, 255, 255, 0.28); margin-top: 0px;" data-testid="dancer-languages"><div class="text-[11px] tracking-[2px]" style="color: rgb(191, 233, 238);">SPEAKS</div><div class="mt-1 text-[15px] font-extrabold break-words">English, Spanish</div></div></header><section aria-label="Contact" data-testid="dancer-connect"><h2 class="mt-6 mb-2 text-[13px] font-extrabold uppercase tracking-[1.5px]" style="color: rgb(94, 224, 230);">Contact</h2><ul class="flex flex-col gap-2"><li class="flex items-center rounded-xl" style="background: rgb(13, 51, 64); border: 1px solid rgb(31, 85, 102);"><a href="https://instagram.com/ricky" target="_blank" rel="noopener noreferrer" class="flex-1 min-w-0 min-h-[50px] flex items-center gap-2 pl-3.5 text-[15px] font-bold underline underline-offset-4 decoration-[1.5px]" style="color: rgb(94, 224, 230);"><span class="truncate">@ricky</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right w-3.5 h-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></a><button type="button" aria-label="Copy Instagram handle" class="inline-flex items-center justify-center gap-1.5 px-4 h-[50px] text-[13px] font-extrabold shrink-0" style="border-left: 1px solid rgb(31, 85, 102); color: rgb(94, 224, 230); background: transparent;" data-testid="dancer-copy"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy w-[18px] h-[18px]" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>Copy</button></li></ul></section><section aria-label="Achievements" data-testid="dancer-highlights"><h2 class="mt-6 mb-2 text-[13px] font-extrabold uppercase tracking-[1.5px]" style="color: rgb(94, 224, 230);">Achievements</h2><ul class="rounded-[14px] p-3.5 space-y-1" style="background: rgb(13, 51, 64); border: 1px solid rgb(31, 85, 102);"><li class="text-[14px] leading-normal break-words">Won a thing</li></ul></section><p class="pt-6 text-center text-[13px]" style="color: rgb(143, 186, 199);" data-testid="dancer-join">Dance bachata too? <a class="font-extrabold underline" style="color: rgb(94, 224, 230);" href="/auth?mode=signup&amp;returnTo=%2Fdancers%2Fx" data-discover="true">Get your own card</a></p></div>"`;
