  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/arc-checkpoint.mjs --event=UserPromptSubmit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/session-lock.mjs heartbeat --hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/session-lock.mjs acquire --warn-only --hook"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/session-boot.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/arc-checkpoint.mjs --event=SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/session-lock.mjs heartbeat --hook --quiet"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/session-lock.mjs release --hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-write-block.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-write-check.sh"
          }
        ]
      },
      {
        "matcher": "ReportFindings",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/review-stamp.mjs"
