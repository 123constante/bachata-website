  "landing": "/account/o",
  "tree": "heading "Home" level=1
button "Your account" [expanded=false]
status
text "No events yet"
text "Add your first event. You can keep it as a draft until it is ready."
button "New event"
link "Add another organiser" href=/account/o?add=1
navigation "Organiser"
  link "Home" href=/account/o
  link "Events" href=/account/o/events
  link "Team" href=/account/o/team
  link "Profile" href=/account/o/profile",
}
`;

exports[`/account entry at 'desktop' > /account/o > 'signed out' 1`] = `
{
  "landing": "/auth?mode=signin&returnTo=<encoded>",
  "tree": "text "auth page"",
}
`;
