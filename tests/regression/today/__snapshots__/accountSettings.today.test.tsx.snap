exports[`account settings at '390x844' > /account/settings/delete: the delete (= hide) flow > a admin_account delete stays on the page, does not sign out, and says so 1`] = `
"heading "Delete account" level=1
heading "What happens" level=2
text "Your profile is hidden from everyone straight away, and you are signed out on every device."
text "Sign in within 30 days to undo it: your account comes back as it was."
text "After that it stays hidden. For a full erase of your data, ask us at ."
text "support @bachatacalendar.co.uk"
heading "Keep a copy first?" level=2
text "Download your data now, while you are signed in."
button "Download my data"
heading "Or just hide your profile" level=2
text "Hiding is reversible and keeps your account."
link "Hide my profile instead" href=/account/settings
heading "Delete my account" level=2
text "This is an admin account, so it can't be deleted here. You can still hide your dancer profile instead."
button "Delete my account" [disabled]
text "You cannot delete your account yet. See the reason above.""
`;

