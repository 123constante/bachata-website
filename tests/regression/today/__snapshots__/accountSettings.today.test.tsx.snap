text "Your sign-in: you will not be able to log back in"
text "This happens straight away and cannot be undone."
heading "Keep a copy first?" level=2
text "Download your data now. After deleting, it is gone."
button "Download my data"
heading "Or just hide your profile" level=2
text "Hiding is reversible and keeps your account."
link "Hide my profile instead" href=/account/settings
heading "Delete my account" level=2
text "Type DELETE to confirm"
textbox "Type DELETE to confirm" value=""
button "Delete my account for good" [disabled]
text "The button works once you type DELETE in capital letters.""
`;

exports[`account settings at 'desktop' > check: plain dancer > /account/settings/ownership 1`] = `
"heading "Account ownership" level=1
heading "Delete your account" level=2
text "Deleting your account is permanent. If you just want a break, hide your dancer profile instead: you can bring it back any time."
link "Back to settings" href=/account/settings
link "Delete account" href=/account/settings/delete"
`;

exports[`account settings at 'desktop' > check: sole organiser owner > /account/settings/delete 1`] = `
"heading "Delete account" level=1
