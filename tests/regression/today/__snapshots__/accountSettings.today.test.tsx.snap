exports[`account settings at '390x844' > /account/settings/delete: the immediate erase flow > a blocked erase stays on the page, does not sign out, and says so 1`] = `
"heading "Delete account" level=1
heading "What you will lose" level=2
text "Your dancer profile and photos"
text "Your ratings and your attendance history"
text "Your sign-in: you will not be able to log back in"
text "This happens straight away and cannot be undone."
heading "Keep a copy first?" level=2
text "Download your data now. After deleting, it is gone."
button "Download my data"
heading "Or just hide your profile" level=2
text "Hiding is reversible and keeps your account."
link "Hide my profile instead" href=/account/settings
heading "Delete my account" level=2
text "You're the only owner of the organiser page(s) below. Add another owner, or remove the page, then come back to delete your account."
text "Salsa Nights"
button "Delete my account for good" [disabled]
text "You cannot delete your account yet. See the reason above.""
`;

