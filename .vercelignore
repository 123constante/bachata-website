# Vercel Function Storage optimization
# Prevent unnecessary files from being uploaded to Vercel Functions

# Test suites and fixtures
tests/
test-results/
.playwright/

# Git and CI
.git/
.github/
.gitignore
.gitattributes

# Development and build artifacts
dist/
.vite/
.turbo/
.eslintcache
*.tsbuildinfo

# Local environment and config
.env.local
.env.*.local
.DS_Store
.vscode/
.idea/

# Configuration files not needed in runtime (build-time-required configs --
# vite.config.ts, react-router.config.ts, postcss.config.js,
# tailwind.config.ts, tsconfig.*.json -- must stay OUT of this list:
# `vercel build` runs `react-router build` from source on Vercel's infra, so
# anything the build step itself reads has to survive .vercelignore, not
# just anything needed at request time. tsconfig.*.json specifically: react-
# router.config.ts is parsed via tsconfck, which resolves and parses
# tsconfig.app.json even though nothing in the build calls tsc directly)
vitest.config.ts
playwright.config.ts
eslint.config.js

# Documentation and guides
CLAUDE.md
README.md
docs/
PRODUCT.md
*.md

# Dependency cache (Vercel installs fresh on deploy)
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnpm-store/

# Scripts and tooling (not needed at runtime)
scripts/
# bin/ is glob-excluded rather than dir-excluded so this one entry can be
# un-ignored -- postinstall (package.json) requires it during `npm install`,
# before build even starts, so it can't just be built/copied in later.
bin/*
!bin/install-hooks.cjs
.claude/
.githooks/

# Public assets (served via CDN)
public/

# Database and migrations (authority in admin repo)
supabase/

# Temporary and log files
*.log
.npmrc
